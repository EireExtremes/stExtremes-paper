# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

##=============================================================================
## Generated by the analysis. All of it is rebuilt by targets::tar_make().
##=============================================================================

# Cached INLA fits. Several GB: four of them are 0.7-2 GB each.
# Written as rds/* rather than rds/, because an excluded DIRECTORY cannot
# have its contents re-included by the negation below.
rds/*

# Exception: cached days-with-data per site-year, 6.5 kB. Tracking it lets
# the coverage blocks of 00_explore_data.R run without the raw sub-hourly
# record, which is not redistributed here.
!rds/explore_data_cov_year.rds

# Figures, png and pdf
figs/

# The targets store: the pipeline's own record of what it has run, plus
# the values of the non-file targets. Rebuilt by tar_make().
_targets/

##=============================================================================
## renv
##
## renv.lock, renv/activate.R, renv/settings.json and .Rprofile ARE
## tracked: they are what makes the environment restorable. The project
## library is not, and renv/.gitignore already excludes it.
##=============================================================================

##=============================================================================
## Not ours to redistribute: the raw combined record and the partitioned
## residuals upstream of data/dc_max_all_time_residual.rda
##=============================================================================
data/dc_max_files/processed/
data/dc_max_files/outputs/
data/dc_max_files/figs/
